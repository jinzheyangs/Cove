# 复制为 .env 后填入真实值。.env 不进仓库。

# ---- App ----
ENV=dev
DEBUG=true

# ---- PostgreSQL ----
POSTGRES_USER=cove
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cove
# 本地直接运行（uv run ...）用 localhost；容器内由 docker-compose 覆盖为 postgres
DATABASE_URL=postgresql+asyncpg://cove:change-me@localhost:55432/cove

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Auth ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# 字段加密密钥。生成：openssl rand -base64 32
# 上线后更换会导致旧数据无法解密，务必先备份并做 re-encrypt
DATA_ENCRYPTION_KEY=

# ---- LLM ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 日志 / 限流 ----
LOG_LEVEL=INFO
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_REQUESTS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
DAILY_GIFT_LIMIT=500

# 备份加密口令（scripts/backup_db.sh 使用）
BACKUP_PASSPHRASE=change-me

# ---- 对象存储 ----
# local：开发用本地目录；oss：阿里云对象存储
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
# 公共读桶或 CDN 的访问前缀，例如 https://cdn.example.com
STORAGE_PUBLIC_BASE_URL=
# 私有桶签名 URL 有效期（秒）
STORAGE_URL_EXPIRE_SECONDS=3600

# 阿里云 OSS（STORAGE_BACKEND=oss 时必填）
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# true = 私有桶，读取时生成签名 URL
OSS_PRIVATE=true

# ---- 模拟TA 的 RAG ----
RAG_ENABLED=true
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=cove_persona
RAG_TOP_K=5
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=50

# embedding 走 OpenAI 兼容接口；不配置时自动退回“最近记录”检索
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0

# ---- 链路追踪 ----
# 本地直接跑用 localhost；docker compose 内会覆盖为 http://jaeger:4318/v1/traces
OTEL_ENABLED=false
OTEL_SERVICE_NAME=cove-api
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLE_RATIO=1.0
METRICS_TOKEN=
