# 复制为 .env 后填入真实值。.env 不进仓库。

# ---- App ----
ENV=dev
DEBUG=true

# ---- PostgreSQL ----
POSTGRES_USER=cove
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cove
DATABASE_URL=postgresql+asyncpg://cove:change-me@postgres:5432/cove

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Chroma ----
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ---- Auth ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---- LLM ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
