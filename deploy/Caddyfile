# Cove 生产反代配置（Caddy）。
# 域名从环境变量 DOMAIN 读取，由 compose 注入（值写在 .env）。
# 没有域名 / 内网试部署：DOMAIN=:80，只跑 HTTP，不申请证书。

{$DOMAIN} {
	encode zstd gzip

	# 本地上传的图片直接由 Caddy 从磁盘发，不经过 Python。
	# 走 OSS 时前端拿到的是 OSS 地址，不会进这里，配置留着也无害。
	handle_path /uploads/* {
		root * /srv/uploads
		file_server
	}

	# AI 服务是独立进程（agent），单独转发
	handle /api/v1/agent* {
		reverse_proxy agent:8100
	}

	# 前端入口 HTML 每次都回源校验。发版后浏览器必须拿到新的 index.html，
	# 否则会一直用缓存的旧入口，引用到已经不存在的旧 CSS/JS，
	# 表现就是"明明改了、手机上看着一模一样"。
	@entry path / /index.html
	header @entry Cache-Control "no-store, must-revalidate"

	# 其余全部交给业务后端：前端静态文件、业务接口、/docs
	handle {
		reverse_proxy api:8000
	}
}
